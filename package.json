{
  "name": "internet-archive-explorer",
  "private": true,
  "version": "1.3.19",
  "packageManager": "pnpm@10.6.1",
  "homepage": "https://qnbs.github.io/Internet-Archive-Explorer",
  "type": "module",
  "scripts": {
    "postinstall": "pnpm audit --audit-level=moderate || true",
    "sync:locales": "node scripts/sync-locales.mjs",
    "generate:pwa-assets": "node scripts/generate-pwa-assets.mjs",
    "generate:manifest": "node scripts/generate-pwa-assets.mjs",
    "capture:pwa-screenshots": "node scripts/capture-pwa-screenshots.mjs",
    "check:pwa-screenshots": "node scripts/check-pwa-screenshots.mjs",
    "check:pwa-icons": "node scripts/check-pwa-icons.mjs",
    "prebuild": "pnpm run generate:manifest && pnpm run sync:locales",
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "check": "biome ci . && tsc --noEmit && vitest run",
    "check:i18n": "node scripts/sync-locales.mjs --check",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:commit-msg": "node scripts/check-commit-msg.mjs",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit fix --audit-level=moderate",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@google/genai": "^1.19.0",
    "@tanstack/react-query": "^5.104.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.16",
    "framer-motion": "^12.35.1",
    "jotai": "^2.14.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": ["CVE-2026-93687"]
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.6.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2",
    "vite": "^8.3.2",
    "vite-bundle-analyzer": "^1.3.9",
    "vitest": "^4.1.11"
  }
}
